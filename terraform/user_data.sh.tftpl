#!/bin/bash
set -euxo pipefail

# Phase 5: deploy the real Flask app. It arrives as a self-contained bundle
# (code + vendored ARM64 wheels, built by CI's build-and-deploy-app job) so
# nothing here ever needs PyPI -- app subnets have no internet path, only
# the S3 gateway endpoint from Phase 3, which is what fetches this bundle.

# python3-pip isn't in the base AL2023 image. dnf can still reach it: AL2023's
# package repos are backed by S3 buckets AWS operates, reachable through the
# same free S3 gateway endpoint used for the bundle below -- no NAT needed.
dnf install -y python3-pip unzip

mkdir -p /opt/app
aws s3 cp "s3://${deploy_bucket}/bundle.zip" /opt/app/bundle.zip --region ${aws_region}
unzip -o /opt/app/bundle.zip -d /opt/app

# --no-index --find-links installs only from the vendored wheels shipped in
# the bundle -- pip never attempts to reach PyPI.
pip3 install --no-index --find-links=/opt/app/vendor -r /opt/app/requirements.txt

# The instance's IAM role (from Phase 2) grants exactly this one secret's
# GetSecretValue -- nothing else. python3's json module (stdlib, no install
# needed) parses it directly rather than pulling in a jq dependency.
aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region ${aws_region} \
  --query SecretString \
  --output text > /tmp/db_secret.json

python3 - <<'PYEOF'
import json

with open("/tmp/db_secret.json") as f:
    secret = json.load(f)

with open("/etc/app.env", "w") as f:
    f.write(f"DB_HOST={secret['host']}\n")
    f.write(f"DB_PORT={secret['port']}\n")
    f.write(f"DB_USER={secret['username']}\n")
    f.write(f"DB_PASSWORD={secret['password']}\n")
    f.write(f"DB_NAME={secret['dbname']}\n")
PYEOF

chmod 600 /etc/app.env
rm -f /tmp/db_secret.json

cat >> /etc/app.env <<EOF
APP_PORT=${app_port}
RECEIPTS_BUCKET=${receipts_bucket}
AWS_DEFAULT_REGION=${aws_region}
EOF

cat > /etc/systemd/system/app.service <<UNITEOF
[Unit]
Description=Budget Tracker Flask app
After=network.target

[Service]
EnvironmentFile=/etc/app.env
WorkingDirectory=/opt/app
ExecStart=/usr/bin/python3 /opt/app/app.py
Restart=always
User=root

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable --now app.service
